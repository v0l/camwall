#cloud-config
hostname: camwall
timezone: Etc/UTC

users:
  - name: pi
    groups: [sudo, adm, video, render, input]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAA... you@example
  - name: camwall
    system: true
    groups: [video, render, input]
    shell: /usr/sbin/nologin

ssh_pwauth: false
package_update: true
packages: [cage, libegl1, libgles2, libgl1-mesa-dri, wlr-randr, grim]

write_files:
  - path: /etc/camwall.env
    permissions: '0640'
    content: |
      FRIGATE_URL=https://frigate.local:8971
      FRIGATE_USER=camwall
      FRIGATE_PASSWORD=changeme
      FRIGATE_INSECURE=1
      DIM_AFTER=60
      DIM_BRIGHTNESS=0.3
      OFF_AFTER=1800
      SCREEN_OFF_COMMAND=wlr-randr --output HDMI-A-1 --off
      SCREEN_ON_COMMAND=wlr-randr --output HDMI-A-1 --on
  - path: /etc/udev/rules.d/90-backlight.rules
    content: |
      ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
  - path: /etc/systemd/system/camwall.service
    content: |
      [Unit]
      Description=camwall Frigate camera wall
      After=systemd-user-sessions.service network-online.target getty@tty1.service
      Wants=network-online.target
      Conflicts=getty@tty1.service

      [Service]
      User=camwall
      PAMName=login
      TTYPath=/dev/tty1
      TTYReset=yes
      TTYVHangup=yes
      TTYVTDisallocate=yes
      StandardInput=tty-fail
      StandardOutput=journal
      StandardError=journal
      UtmpIdentifier=tty1
      UtmpMode=user
      Environment=XDG_SESSION_TYPE=wayland
      EnvironmentFile=/etc/camwall.env
      ExecStart=/usr/bin/cage -d -- /usr/local/bin/camwall
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [chgrp, camwall, /etc/camwall.env]
  - [sh, -c, "curl -fsSL https://github.com/v0l/camwall/releases/latest/download/camwall-aarch64-linux.tar.gz | tar xz -C /tmp"]
  - [install, -m755, /tmp/camwall-aarch64-linux/camwall, /usr/local/bin/camwall]
  - [sh, -c, "grep -q consoleblank= /boot/firmware/cmdline.txt || sed -i '1 s/$/ consoleblank=0 vt.global_cursor_default=0/' /boot/firmware/cmdline.txt"]
  - [systemctl, daemon-reload]
  - [systemctl, disable, getty@tty1]
  - [systemctl, enable, --now, ssh]
  - [systemctl, enable, --now, camwall]
